// The website (site/) as a Cloudflare Worker with static assets. Deploy: npx wrangler@4 deploy
{
	"name": "aerial-tv",
	"compatibility_date": "2026-10-13",
	"assets": {
		"directory": "./site"
	},
	"routes": [
		{ "pattern": "aerial.qust.me", "custom_domain": true },
		{ "pattern": "tv.qust.me", "custom_domain": true }
	]
}
